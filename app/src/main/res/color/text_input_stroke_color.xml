<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color when the input is focused -->
    <item android:color="@color/primary_brand" android:state_focused="true"/>
    <!-- Color when the input is hovered (for devices that support it) -->
    <item android:color="@color/text_secondary" android:state_hovered="true"/>
    <!-- Color when the input is disabled -->
    <item android:color="@color/gray" android:state_enabled="false"/>
    <!-- Default color (unfocused and enabled) -->
    <item android:color="@color/text_secondary"/>
</selector>

